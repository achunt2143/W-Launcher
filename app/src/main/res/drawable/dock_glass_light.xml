<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frosted glass background with rounded top corners -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/webos_dock_glass_light_top"
                android:endColor="@color/webos_dock_glass_light_bottom" />
        </shape>
    </item>

    <!-- Outer subtle highlight stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <stroke
                android:width="1dp"
                android:color="@color/webos_dock_glass_highlight" />
        </shape>
    </item>

    <!-- Specular highlight line along the top edge (authentic webOS quick_launch_bg specular) -->
    <item
        android:top="1dp"
        android:height="2dp"
        android:left="24dp"
        android:right="24dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#80FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>

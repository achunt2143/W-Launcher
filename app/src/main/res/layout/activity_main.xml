<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MainActivity"
    app:defaultNavHost="true"
    app:navGraph="@navigation/nav_graph">

    <!-- clipToOutline + the transparent rounded-rect background below clip this container's
         content (home screen, apps drawer, About & Settings, Credits — whichever fragment is
         loaded) to rounded corners, edge-to-edge with the live wallpaper showing through
         everywhere else in the window. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/container"
        android:layout_height="0dp"
        android:background="@drawable/homescreen_rounded_clip"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@+id/notificationContainer"
        app:layout_constraintTop_toTopOf="parent">
    </FrameLayout>

    <!-- Fills the gap between the home screen's rounded bottom corners and the notification
         panel's rounded top corners while the panel is present; sized automatically by its
         own top/bottom constraints to whatever gap container's bottomMargin currently reserves. -->
    <View
        android:id="@+id/notificationGapFill"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:layout_marginBottom="-20dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/container"
        app:layout_constraintBottom_toTopOf="@id/notificationContainer" />

    <com.achunt.weboslauncher.MaxHeightFrameLayout
        android:id="@+id/notificationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/notif_panel_background"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

    </com.achunt.weboslauncher.MaxHeightFrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
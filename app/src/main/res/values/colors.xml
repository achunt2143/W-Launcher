    <!-- Light theme's own icon squircle — frosted white instead of Dark theme's gunmetal,
         so icons read as part of the blue wallpaper rather than dark chrome pasted onto it -->
    <color name="webos_icon_bg_light">#4DFFFFFF</color>
    <!-- Dims the wallpaper behind text/labels that sit directly on it (not inside an opaque
         list-group card) so they stay readable regardless of how bright that patch of the
         blue/gradient wallpaper happens to be. -->
    <color name="webos_content_scrim">#66000000</color>
    <!-- Legibility shadow for icon labels in the apps drawer grid, which also sit directly
         on the wallpaper — same problem, smaller footprint, so a shadow suits it better than
         a full scrim. -->
    <color name="webos_label_shadow">#B3000000</color>

    <!-- Dock "frosted glass" tray: same blue/gunmetal gradient family as the matching header,
         just translucent so it reads as glass sitting over the wallpaper (or the apps-drawer
         backdrop) rather than a flat opaque bar. -->
    <color name="webos_dock_glass_light_top">#E65B92B7</color>
    <color name="webos_dock_glass_light_bottom">#F53E6C88</color>
